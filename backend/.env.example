# Backend. Copie para .env (local) ou configure como env vars no Render.
# NUNCA comite o .env (já está no .gitignore).

# --- Sienge (sem isto o app roda em modo DEMO) ---
SIENGE_SUBDOMAIN=
SIENGE_API_USER=
SIENGE_API_PASSWORD=

# --- Supabase (auth + auditoria). Sem isto: sem login e auditoria em SQLite local ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=eyJ...   # chave anon (mesma do app de validação)

# --- CORS: origem(ns) do frontend na Vercel, separadas por vírgula ---
ALMOX_CORS_ORIGINS=https://almoxarifado-r21.vercel.app

# opcional: rótulo do usuário no modo dev (sem auth)
ALMOX_DEFAULT_USER=almoxarife@r21
